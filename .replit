modules = ["nodejs-24"]
run = "pnpm run dev"

[deployment]
# Reserved VM, not autoscale: the process must stay alive between requests
# so the SharePoint poll in server/import/sync.ts actually fires overnight.
deploymentTarget = "vm"
build = ["pnpm", "run", "build"]
run = ["pnpm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80
