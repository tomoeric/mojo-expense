# ---------------------------------------------------------------------------
# MOJO Expense — environment
# Copy to .env locally, or add these as Replit Secrets. Nothing here has a real
# value committed; the app runs on demo data until the credentials are set.
# ---------------------------------------------------------------------------

PORT=5000

# Neon connection string (use the POOLED one — hostname contains "-pooler").
# Read in order: NEON_DATABASE_URL, EXTERNAL_DATABASE_URL, DATABASE_URL.
# Prefer NEON_DATABASE_URL: Replit injects DATABASE_URL itself when a managed
# Postgres is attached, and that can silently outrank a hand-set secret.
NEON_DATABASE_URL=

# Which Emburse product this tenant is on: spend | professional | enterprise
EMBURSE_PRODUCT=spend

# --- Emburse Spend (the default) -------------------------------------------
# Fastest path: a bearer token issued by Emburse. Set this alone and the app
# skips the OAuth exchange entirely.
EMBURSE_ACCESS_TOKEN=

# Or full OAuth2 client credentials, if that is what Emburse issued you.
EMBURSE_CLIENT_ID=
EMBURSE_CLIENT_SECRET=
EMBURSE_TOKEN_URL=
EMBURSE_SCOPE=

# Defaults to https://api.emburse.com/v1 for Spend.
# EMBURSE_API_URL=

# --- Emburse Professional (Certify) — only if EMBURSE_PRODUCT=professional --
EMBURSE_API_KEY=
EMBURSE_API_SECRET=

# --- Wire details -----------------------------------------------------------
# Override only if the tenant's Swagger disagrees with these defaults.
# EMBURSE_API_KEY_HEADER=x-api-key
# EMBURSE_API_SECRET_HEADER=x-api-secret
# EMBURSE_REPORTS_PATH=transactions   # 'expensereports' on Professional
# EMBURSE_EXPENSES_PATH=expenses
# EMBURSE_RECEIPTS_PATH=receipts
# EMBURSE_PAGE_PARAM=index
# EMBURSE_PAGE_START=0
# EMBURSE_DATE_START_PARAM=startDate
# EMBURSE_DATE_END_PARAM=endDate
# EMBURSE_MAX_PAGES=25
# EMBURSE_TIMEOUT_MS=20000
# EMBURSE_CACHE_TTL_SEC=300

# --- Microsoft SSO (Entra ID) ----------------------------------------------
# Same app registration ninja-live-status uses. Add the redirect URI
#   https://<your-repl>.replit.app/api/callback
# under Authentication → Web in the Entra app registration first.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Signs the session cookie. REQUIRED in production — generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional second filter on top of the tenant restriction. Comma-separated
# emails and/or bare domains. Empty = anyone in the tenant may sign in.
# AUTH_ALLOWED=ap@mojocarwash.com, finance.mojocarwash.com

# --- SharePoint sync (watch a folder for the daily export) -------------------
# Defaults point at AI Projects > Shared Documents > Emburse Transactions.
# Needs the APPLICATION permission Sites.Read.All (or Sites.Selected on the
# site) with admin consent on the AZURE_* app registration above.
# SHAREPOINT_DRIVE_ID=
# SHAREPOINT_FOLDER_ID=
# SHAREPOINT_POLL_MINUTES=60

# --- Emburse browser automation -------------------------------------------
# The app signs into Emburse itself and fetches the daily export. The login it
# uses is normally entered IN THE APP, under the user menu -> Your Emburse
# login, where it is stored encrypted and never shown again. These env vars are
# only a fallback for a deployment where nobody has entered one.
# EMBURSE_LOGIN_URL=https://app.spend.emburse.com
# EMBURSE_LOGIN_EMAIL=
# EMBURSE_LOGIN_PASSWORD=
# Chromium for Playwright. Needed wherever the host ships its own browser,
# since Playwright insists on the exact build it was published with.
# PLAYWRIGHT_CHROMIUM_PATH=
# Stored passwords are encrypted with a key derived from SESSION_SECRET unless
# a dedicated one is set here. Changing either makes stored logins unreadable,
# and their owners are asked to enter them again.
# EMBURSE_CREDENTIAL_KEY=

# --- Export schedule: STARTING VALUES ONLY --------------------------------
# The live schedule is edited in the app, under the user menu -> Export
# settings, and stored in the database. These are only the defaults a fresh
# database starts from; changing them later has no effect on an app that has
# already saved settings.
# EXPORT_TIMEZONE=America/Chicago
# EXPORT_FIRST_RUN=06:00
# EXPORT_RETRY_HOURS=3
# EXPORT_ATTEMPTS_PER_DAY=2
# How long after an attempt to keep waiting before calling it a miss. Covers the
# Emburse export queue plus one full SHAREPOINT_POLL_MINUTES.
# EXPORT_GRACE_MINUTES=90

# --- Receipt checking (reads the receipt and compares it to the claim) ------
# Without this the app works normally; only the "Check receipts" action is off.
# Either provision Replit's Anthropic AI integration (preferred — same one
# ninja-live-status uses, no separate account or billing):
#   AI_INTEGRATIONS_ANTHROPIC_API_KEY / AI_INTEGRATIONS_ANTHROPIC_BASE_URL
# ...or paste a direct key from console.anthropic.com here:
ANTHROPIC_API_KEY=
# RECEIPT_AUDIT_MODEL=claude-opus-5
# RECEIPT_AUDIT_TOLERANCE=0.02
# RECEIPT_AUDIT_TOLERANCE_PCT=0.01

# --- Review policy thresholds ----------------------------------------------
POLICY_RECEIPT_REQUIRED_OVER=25
POLICY_LARGE_LINE_OVER=500
POLICY_AGEING_AFTER_DAYS=5
