# ---------------------------------------------------------------------------
# MOJO Expense — environment
# Copy to .env locally, or add these as Replit Secrets. Nothing here has a real
# value committed; the app runs on demo data until the credentials are set.
# ---------------------------------------------------------------------------

PORT=5000

# Which Emburse product this tenant is on: professional | enterprise | spend
# "professional" (formerly Certify) is the expense-report review workflow.
EMBURSE_PRODUCT=professional

# --- Emburse Professional (Certify) -----------------------------------------
EMBURSE_API_KEY=
EMBURSE_API_SECRET=
EMBURSE_API_URL=https://api.certify.com/v1

# --- Emburse Enterprise (Chrome River) / Emburse Spend ----------------------
# Used instead of the key/secret pair when EMBURSE_PRODUCT is enterprise or spend.
EMBURSE_CLIENT_ID=
EMBURSE_CLIENT_SECRET=
EMBURSE_TOKEN_URL=
EMBURSE_SCOPE=

# --- Wire details -----------------------------------------------------------
# Override only if the tenant's Swagger disagrees with these defaults.
# EMBURSE_API_KEY_HEADER=x-api-key
# EMBURSE_API_SECRET_HEADER=x-api-secret
# EMBURSE_REPORTS_PATH=expensereports
# EMBURSE_EXPENSES_PATH=expenses
# EMBURSE_PAGE_PARAM=index
# EMBURSE_PAGE_START=0
# EMBURSE_DATE_START_PARAM=startDate
# EMBURSE_DATE_END_PARAM=endDate
# EMBURSE_MAX_PAGES=25
# EMBURSE_TIMEOUT_MS=20000
# EMBURSE_CACHE_TTL_SEC=300

# --- Review policy thresholds ----------------------------------------------
POLICY_RECEIPT_REQUIRED_OVER=25
POLICY_LARGE_LINE_OVER=500
POLICY_AGEING_AFTER_DAYS=5
