modules = ["nodejs-24"]

[env]
# Keep Playwright's browser inside node_modules so it is rebuilt with the
# deployment; a home-directory cache does not reliably travel with one.
PLAYWRIGHT_BROWSERS_PATH = "0"
run = "pnpm run dev"

[deployment]
# Reserved VM, not autoscale: the process must stay alive between requests
# so the SharePoint poll in server/import/sync.ts actually fires overnight.
deploymentTarget = "vm"
build = ["pnpm", "run", "build"]
run = ["pnpm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80
